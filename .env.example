# Copy to .env (gitignored) or export in your shell.

# --- Private data (separate git repo; required for real archives) ---
GOUTOU_DATA_REPO_URL=git@github.com:Horan-Ding/goutou-data.git
GOUTOU_DATA_DIR=/Users/you/code/haoran/goutou-data

# Default person codename for this session (optional)
# GOUTOU_ACTIVE_PERSON=demo-alice

# LLM keys — only if you add local tools later
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Background sync interval (seconds); Linux, requires flock (util-linux)
GOUTOU_SYNC_INTERVAL_SECONDS=600
# Optional remote branch override when local branch names differ
# GOUTOU_DATA_BRANCH=main
