{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/goutou-junshi/schemas/message-line.schema.json",
  "title": "NormalizedChatLine",
  "type": "object",
  "additionalProperties": false,
  "required": ["from", "text"],
  "properties": {
    "id": { "type": "string", "description": "Stable id for dedup (ulid or content hash)" },
    "ts": { "type": "string", "format": "date-time" },
    "ts_inferred": { "type": "boolean", "description": "True when ts was guessed from screenshot" },
    "from": { "type": "string", "enum": ["me", "them", "system"] },
    "text": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["text", "image", "sticker", "system"],
      "default": "text"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "import_id"],
      "properties": {
        "type": { "type": "string", "enum": ["screenshot", "paste", "export"] },
        "import_id": { "type": "string" },
        "image": {
          "type": "string",
          "description": "Relative path under conversations/, usually raw/imports/..."
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
