{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/goutou-junshi/schemas/message-line.schema.json",
  "title": "NormalizedChatLine",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts", "from", "text"],
  "properties": {
    "ts": { "type": "string", "format": "date-time" },
    "from": { "type": "string", "enum": ["me", "them"] },
    "text": { "type": "string" },
    "kind": { "type": "string", "enum": ["text", "image", "sticker", "system"], "default": "text" }
  }
}
