{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/goutou-junshi/schemas/meta.schema.json",
  "title": "PersonMeta",
  "type": "object",
  "additionalProperties": false,
  "required": ["codename", "platform"],
  "properties": {
    "codename": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "description": "代号，禁止真名"
    },
    "platform": {
      "type": "string",
      "enum": ["wechat", "soul", "tantan", "bumble", "tinder", "qq", "other"]
    },
    "known_since": { "type": "string", "format": "date" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "boundaries_notes": { "type": "string" },
    "attribution": {
      "type": "object",
      "properties": {
        "imported_from": { "type": "string" }
      }
    }
  }
}
